SetSeed(1);

G27<x,y>:=PermutationGroup<27|\[1,3,2,6,8,4,12,5,16,10,11,7,13,14,15,9,17,18,22,20,21,19,23,24,25,
26,27],\[2,4,1,7,3,10,13,14,5,15,6,19,17,21,8,20,9,11,24,12,23,16,18,26,22,27,25]>;

SetSeed(1);

G40A<x,y>:=PermutationGroup<40|\[2,1,4,3,7,9,5,13,6,17,18,19,8,21,22,23,10,11,12,27,14,15,16,32,33,34,20,36,37,35,38,24,25,26,30,28,29,31,40,39],\[3,4,6,1,2,10,11,5,15,14,17,7,16,8,20,9,13,24,25,12,28,30,18,23,31,19,35,26,21,29,22,33,38,27,34,39,36,32,37,40]>;

G40B<x,y>:=PermutationGroup<40|\[1,4,6,2,9,3,7,13,5,17,18,20,8,22,23,16,10,11,25,12,21,14,15,24,19,32,27,28,35,30,33,26,31,40,29,37,36,38,39,34],\[2,5,1,7,10,11,3,4,15,14,19,6,21,8,12,9,24,26,13,28,16,23,25,31,17,33,18,34,20,22,38,39,36,27,32,29,30,37,35,40]>;

Order(G27);
CompositionFactors(G27);

GSp:=CSp(4,3);
PGSp,pi:=quo<GSp|Center(GSp)>;
ZPGSp:=Subgroups(PGSp);
PSp:=ZPGSp[#ZPGSp - 1]`subgroup;

A,phi27:=IsIsomorphic(PGSp,G27);
A,phi40a:=IsIsomorphic(PGSp,G40A);
A,phi40b:=IsIsomorphic(PGSp,G40B);

/* the conjugacy classes in question in PGSp4(F3)\PSp_4(F3) */

CC:=ConjugacyClasses(PGSp);
CCgood:=[];
CCgoodlift:=[];
CCorders:=[];
for i in [1..#CC] do
	c:=CC[i][3]; order:=CC[i][2];
	if c notin PSp then
		g:= c @@ pi;
		CCgood:=Append(CCgood,c);
		CCgoodlift:=Append(CCgoodlift,g);
		CCorders:=Append(CCorders,order);
		end if;
	end for;

ClassName:=["2C", "2D", "4C", "4D", "6H", "6G", "6I", "8A", "10A", "12C"];

OrbitSizes := function(g)
    H := sub<Parent(g) | g>;
    return Sort([ #O : O in Orbits(H) ]);
end function;


/* Now the data */

F:=GF(3);
F<x>:=PolynomialRing(F);

print("########Conjugacy classes in PGSp4(F3)\PSp_4(F3)########");
for i in [1..#CCgood] do
c:=CCgood[i]; g:=CCgoodlift[i]; o:=CCorders[i];
print("class name");
ClassName[i];
print("[order of element,|conjugacy class|]");
[Order(c),o];
print("char poly of lift");
F!CharacteristicPolynomial(g);
print("order 40a type");
OrbitSizes(phi40a(c));
print("order 27 type");
OrbitSizes(phi27(c));
